{% extends 'base.html.twig' %}

{% block title %}Gérer les comptes utilisateur
{% endblock %}

{% block body %}

	<section class="py-5">
		<div class="container">


			<h1 class="hero-heading mb-5 mt-3 mt-md-0">Suspendre un compte utilisateur</h1>

			<div class="table-responsive">
				<table class="table table-striped table-hover">
					<thead>
						<tr>
							<th>Id</th>
							<th>Email</th>
							{# <th>Password</th> #}
							<th>Pseudo</th>
							<th>Création du compte</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for user in users %}
							<tr>
								<td>{{ user.id }}</td>
								<td>{{ user.email }}</td>
								{# <td>{{ user.password }}</td> #}
								<td>{{ user.pseudo }}</td>
								<td>{{ user.dateCreation ? user.dateCreation|date('Y-m-d') : '' }}</td>
								<td>
									{# <a class="btn btn-outline-primary px-4 me-md-2" href="{{ path('app_user_delete', {'id': user.id}) }}">Supprimer</a> #}
									<form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Voulez-vous suspendre ce compte utilisateur ?');">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
										<button class="btn  btn-outline-primary px-4 me-md-2">Suspendre</button>
									</form>
									{# <a href="{{ path('app_user_edit', {'id': user.id}) }}">edit</a> #}
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="9">Pas de compte utilisateur.</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			<div class="text-center m-5">
				<a class="btn btn-outline-primary px-4 me-md-2" href="{{ path('app_admin')}}">Retour</a>
			</div>


		</div>
	</section>
{% endblock %}
