{% extends 'base.html.twig' %}

{% block title %}Mon Espace
{% endblock %}

{% block body %}


	{% set isPassengerOnly = app.user.statut == 'passager' %}


	<section class="py-5">
		<div class="container">
			<div class="row mt-4">

				<div class="col-lg-3 mb-4">
					<div
						class="text-center p-4 h-100">

						<!-- Photo utilisateur -->
						{% if app.user.photoFilename %}
							<img src="{{ asset('uploads/photos/' ~ app.user.photoFilename) }}" alt="Photo de {{ user.pseudo }}" class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover;">
						{% else %}
							<img src="{{ asset('assets/images/avatar.png') }}" alt="Pas de photo" class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover; opacity: 0.5;">
						{% endif %}


						<!-- Note (étoiles) -->
						{% if moyenne_note is not null %}
							<div class="text-warning mb-3 mt-2">
								{% for i in 1..5 %}
									<i class="fa{{ i <= moyenne_note ? 's' : 'r' }} fa-star"></i>
								{% endfor %}
							</div>
						{% endif %}

						<!-- Infos avec icônes -->
						<div class="text-start mt-4 card-account">
							<p>
								<i class="fa-solid fa-comments me-2 fa-account"></i>
								{{ reviewCount }}
								avis</p>

							<p>
								<i class="fa-solid fa-coins me-2 fa-account"></i>
								{{ app.user.credits ?? 0 }}
								crédit{{ (app.user.credits ?? 0) > 1 ? 's' : '' }}</p>
							<p>
								<i class="fa-solid fa-tag me-2 fa-account"></i>
								{{ app.user.statut }}</p>

							<p>
								<i class="fa-account fa-solid fa-calendar me-2"></i>Membre depuis le
								{{ app.user.dateCreation|date('d/m/Y') }}</p>
						</div>

					</div>
				</div>


				<div class="col-lg-9 ps-lg-5">
					<div>

						<div>
							<h1 class="hero-heading mb-0">Bonjour
								{{app.user.pseudo}}</h1>
							<p>Tes prochains compagnons de route t'attendent.</p>
						</div>


						<div class="row mt-5">

							<div class="col-12 col-md-4 mb-4">
								<div class="card h-100 border-0 shadow hover-animate">
									<div class="card-body">
										<div class="icon-rounded bg-secondary-light mb-3">
											<i class="fa-regular fa-address-card"></i>
										</div>
										<h5 class="card-title mb-3">
											<a class="text-decoration-none text-dark stretched-link" href="{{ path ('app_account_infos') }}">Mes infos</a>
										</h5>
										<p class="text-muted card-text text-sm">Modifier vos informations personnelles</p>
									</div>
								</div>
							</div>

							<div class="col-12 col-md-4 mb-4">
								<div class="card h-100 border-0 shadow hover-animate">
									<div class="card-body">
										<div class="icon-rounded bg-secondary-light mb-3">
											<i class="fa-solid fa-suitcase"></i>
										</div>
										<h5 class="card-title mb-3">
											<a class="text-decoration-none text-dark stretched-link" href="{{ path ('app_reservation_account') }}">Mes réservations</a>
										</h5>
										<p class="text-muted card-text text-sm">Visualiser vos réservations passées et à venir</p>
									</div>
								</div>
							</div>

							<div class="col-12 col-md-4 mb-4">
								<div class="card h-100 border-0 shadow hover-animate">
									<div class="card-body">
										<div class="icon-rounded bg-secondary-light mb-3">
											<i class="fa-solid fa-tag"></i>
										</div>
										<h5 class="card-title mb-3">
											<a class="text-decoration-none text-dark stretched-link" href="{{ path ('app_account_statut') }}">Mon statut</a>
										</h5>
										<p class="text-muted card-text text-sm">Modifier votre statut</p>
									</div>
								</div>
							</div>

							{% if isPassengerOnly %}
								<div class="col-12">
									<div class="text-center px-3 px-md-5 py-4">
										<a href="{{ path('app_become_chauffeur_vehicule')}}" class="btn btn-outline-primary btn-lg px-4 me-md-2">Devenir chauffeur</a>
										<p class="mt-3 text-muted">En devenant chauffeur, vous pourrez ajouter un véhicule et vos préférences de conduite avant de proposer vos trajets à la communauté EcoRide !</p>
									</div>
								</div>
							{% endif %}


							<div class="col-12 col-md-4 mb-4">
								<div class="card h-100 border-0 shadow hover-animate {{ isPassengerOnly ? 'opacity-50' }}">
									<div class="card-body">
										<div class="icon-rounded bg-secondary-light mb-3">
											<i class="fa-solid fa-road"></i>
										</div>
										<h5 class="card-title mb-3">
											{% if not isPassengerOnly %}
												<a class="text-decoration-none text-dark stretched-link" href="{{ path ('app_trajet_account') }}">Mes trajets</a>
											{% else %}
												<a class="text-decoration-none text-dark stretched-link" href="#">Mes trajets</a>
											{% endif %}
										</h5>
										<p class="text-muted card-text text-sm">Visualiser vos trajets passés et à venir</p>
									</div>
								</div>
							</div>

							<div class="col-12 col-md-4 mb-4">
								<div class="card h-100 border-0 shadow hover-animate {{ isPassengerOnly ? 'opacity-50' }}">
									<div class="card-body">
										<div class="icon-rounded bg-secondary-light mb-3">
											<i class="fa-solid fa-car-side"></i>
										</div>
										<h5 class="card-title mb-3">
											{% if not isPassengerOnly %}
												<a class="text-decoration-none text-dark stretched-link" href="{{ path ('app_vehicule_account') }}">Ma conduite</a>
											{% else %}
												<a class="text-decoration-none text-dark stretched-link" href="#">Ma conduite</a>
											{% endif %}
										</h5>
										<p class="text-muted card-text text-sm">Modifier vos véhicules et vos préférences</p>
									</div>
								</div>
							</div>

							<div class="col-12 col-md-4 mb-4">
								<div class="card h-100 border-0 shadow hover-animate {{ isPassengerOnly ? 'opacity-50' }}">
									<div class="card-body">
										<div class="icon-rounded bg-secondary-light mb-3">
											<i class="fa-solid fa-comments"></i>
										</div>
										<h5 class="card-title mb-3">
											{% if not isPassengerOnly %}
												<a class="text-decoration-none text-dark stretched-link" href="{{ path ('app_avis_account') }}">Mes avis</a>
											{% else %}
												<a class="text-decoration-none text-dark stretched-link" href="#">Mes Avis</a>
											{% endif %}
										</h5>
										<p class="text-muted card-text text-sm">Consulter les avis que vous avez reçu</p>
									</div>
								</div>
							</div>
						</div>

					</div>
				</div>

			</div>
		</div>
	</section>


{% endblock %}
