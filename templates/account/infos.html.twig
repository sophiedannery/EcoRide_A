{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil
{% endblock %}

{% block body %}


	<section class="py-5 mt-3 mt-md-5">
		<div class="container ">
			<div class="row justify-content-center">
				<div class="col-lg-7 mb-5 mb-lg-0 ">

					<h1 class="hero-heading mb-2">Mon profil</h1>
					<p class="trext-muted mb-5">Consultez vos informations personnelles ici.</p>

					<div class="text-block">

						<div class="row align-items-center mb-3">
							<div class="col-12 col-sm-8">
								<h5 class="mb-2 mb-sm-0">Mes infos</h5>
							</div>
							<div class="link-update col-12 col-sm-4 text-sm-end text-start">
								<a href="#">MODIFIER</a>
							</div>
						</div>

						<p class="text-sm text-muted mb-1">
							<i class="fa fa-id-card fa-fw me-2"></i>
							<strong>Pseudo :</strong>
							{{app.user.pseudo}}</p>
						<p class="text-sm text-muted mb-1">
							<i class="fa fa-envelope-open fa-fw me-2"></i>
							<strong>E-mail :</strong>
							{{app.user.email}}</p>
						<p class="text-sm text-muted mb-1">
							<i class="fa-solid fa-tag fa-fw me-2"></i>
							<strong>Statut :</strong>
							{{app.user.statut}}</p>
						<p class="text-sm text-muted mb-1">
							<i class="fa-solid fa-coins fa-fw me-2"></i>
							<strong>Crédits :</strong>
							{{app.user.credits}}
						</p>
					</div>

					<hr>

					<div class="text-block mt-5">
						<div class="row align-items-center mb-3">
							<div class="col-12 col-sm-8">
								<h5 class="mb-2 mb-sm-0">Ma photo</h5>
							</div>
							<div class="link-update col-12 col-sm-4 text-sm-end text-start">
								<a href="#" id="togglePhotoForm" data-state="closed">MODIFIER</a>
							</div>
						</div>

						<div class="text-center text-sm-start">
							{% if app.user.photoFilename %}
								<img src="{{ asset('uploads/photos/' ~ app.user.photoFilename) }}" alt="Photo de profil de {{ app.user.pseudo }}" style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%;"></div>
						{% else %}
							<img src="{{ asset('assets/images/avatar.png') }}" alt="Pas de photo" class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover; opacity: 0.5;">
						{% endif %}
					</div>


					<div id="photoForm" style="display: none;" class="mt-4">
						{% if profileForm.vars.errors|length > 0  %}
							<div class="alert alert-danger">
								{% for error in profileForm.vars.errors %}
									<p>{{error.message}}</p>
								{% endfor %}
							</div>
						{% endif %}

						{{ form_start(profileForm, {
      action: path('app_account_infos'),
      method: 'POST',
      attr: { enctype: 'multipart/form-data' }
  }) }}
						{{ form_row(profileForm.photoFile) }}
						{{ form_errors(profileForm.photoFile) }}

						<div class="justify-content-between mt-4">
							<button class="btn btn-primary me-4" type="submit">Enregistrer</button>
						</div>
						{{ form_end(profileForm) }}
					</div>
				</div>
			</div>
		</div>


		<div class="text-center m-5">
			<a class="btn btn-outline-primary btn-lg px-4 me-md-2" href="{{ path('app_account')}}">Retour</a>
		</div>

	</div>
</section>{% endblock %}
