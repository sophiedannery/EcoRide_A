<div>
	<p class="fs-5">Prochain trajet le
		{{ nextDate|date('d/m/Y') }}:</p>


	<div class="card border {% if nextTrajet.energie == 'électrique' %}  border-success {% endif %}">

		<div class="card-body p-4 pb-0 {% if nextTrajet.energie == 'électrique' %} bg-success bg-opacity-10 {% endif %} ">

			<div class="row g-4 align-item-center ">

				<div class="col-md-3 text-center">
					<h2 class="mt-2 ms-1">{{ nextTrajet.chauffeur }}</h2>
				</div>

				<div class="col-sm-4 col-md-3">
					<h4>{{ nextTrajet.date_depart|date('H:i') }}</h4>
					<h6>{{ nextTrajet.date_depart|date('d/m/Y') }}</h6>
					<p class="mb-0">
						<i class="bi bi-geo-fill text-success"></i>
						{{nextTrajet.adresse_depart}}</p>
				</div>
				<div class="col-sm-4 col-md-3">
					<h4>{{ nextTrajet.date_arrivee|date('H:i') }}</h4>
					<h6>{{ nextTrajet.date_arrivee|date('d/m/Y') }}</h6>
					<p class="mb-0">
						<i class="bi bi-geo-alt-fill text-danger"></i>
						{{nextTrajet.adresse_arrivee}}</p>
				</div>

				<div class="col-sm-4 col-md-3">
					<p>
						<i class="fa-solid fa-users me-2"></i>
						{{ nextTrajet.places_restantes}}
						place{{ nextTrajet.places_restantes > 1 ? 's' : '' }}
					</p>

					<p>
						<i class="fa-solid fa-coins me-2"></i>
						{{ nextTrajet.prix}}
						crédits
					</p>
					<p class="text-success {{ nextTrajet.energie != 'électrique' ? 'd-none' : '' }}">
						<i class="fa-solid fa-leaf me-2"></i>Voyage écologique
					</p>

				</div>


			</div>
		</div>
	</div>


	<a href="{{ path('app_search', { depart: app.request.query.get('depart'), arrivee: app.request.query.get('arrivee'), date: nextTrajet.date_depart|date('Y-m-d') }) }}" class="btn btn-primary btn-lg mt-3">
		Changer ma date
	</a>
</div>
